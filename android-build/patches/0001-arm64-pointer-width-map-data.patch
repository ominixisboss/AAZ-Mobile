@@ -174,6 +174,21 @@ u16 ScriptReadHalfword(struct ScriptContext *ctx)
     return value;
 }
 
+// Reads a pointer-width value out of the script stream. Identical to
+// ScriptReadWord on a 32-bit target; on a 64-bit one the assembler emits an
+// 8-byte pointer (ptr_stream in asm/macros/ptr.inc), so the interpreter has to
+// consume 8 bytes or it desynchronises from the stream.
+uintptr_t ScriptReadPtr(struct ScriptContext *ctx)
+{
+    uintptr_t value = 0;
+    u32 i;
+
+    for (i = 0; i < sizeof(uintptr_t); i++)
+        value |= (uintptr_t)(*(ctx->scriptPtr++)) << (i * 8);
+
+    return value;
+}
+
 u32 ScriptReadWord(struct ScriptContext *ctx)
 {
     u32 value0 = *(ctx->scriptPtr++);
